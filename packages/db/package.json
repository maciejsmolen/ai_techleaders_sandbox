{
  "name": "@devmentor/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:list": "mikro-orm migration:list",
    "seed": "mikro-orm seeder:run",
    "test": "vitest run --project db"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@mikro-orm/seeder": "^7.2.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ],
    "tsLoader": "tsx"
  }
}
