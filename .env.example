# Copy to .env (repo root). Loaded by the app (next.config.ts) and by the
# @devmentor/db CLI (migrations, seeders).

# Matches docker-compose.yml
DATABASE_URL=postgres://devmentor:devmentor@localhost:5432/devmentor

# Connection pool (optional)
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# Log SQL in development (optional)
DATABASE_DEBUG=false

# App log level: fatal, error, warn, info, debug, trace or silent (optional)
LOG_LEVEL=info
